{
  "$schema": "https://mcp.buffer.com/schema/app-submission.json",
  "version": "1.0",

  "app": {
    "name": "Cap Fund Academy Social Media Automation",
    "slug": "cap-fund-academy",
    "description": "Cap Fund Academy automates daily social media content generation and scheduling for rural capital access certifications. Posts are AI-generated, compliance-reviewed, and pushed to LinkedIn, Instagram, and TikTok via Buffer's publishing queue.",
    "logo_url": "https://capfundacademy.com/assets/logo-cfa.png",
    "website_url": "https://capfundacademy.com",
    "contact_email": "support@capfundacademy.com",
    "privacy_policy_url": "https://capfundacademy.com/privacy",
    "terms_of_service_url": "https://capfundacademy.com/terms",
    "category": "social_media_automation",
    "publisher": "Cap Fund Academy",
    "publisher_url": "https://capfundacademy.com"
  },

  "oauth": {
    "redirect_uris": [
      "https://chat.openai.com/aip/oauth_callback",
      "https://chatgpt.com/aip/oauth_callback",
      "https://capfundacademy.com/.netlify/functions/buffer-oauth-callback"
    ],
    "scopes": [
      "publish",
      "read_access"
    ],
    "grant_types": [
      "authorization_code",
      "refresh_token"
    ],
    "token_endpoint_auth_method": "client_secret_post",
    "response_types": ["code"],
    "authorization_endpoint": "https://app.buffer.com/oauth2/authorize",
    "token_endpoint": "https://api.bufferapp.com/1/oauth2/token.json"
  },

  "mcp": {
    "server_url": "https://mcp.buffer.com/mcp",
    "transport": "streamable-http",
    "auth_type": "oauth2",
    "capabilities": [
      "create_post",
      "update_post",
      "delete_post",
      "get_channels",
      "get_queue",
      "schedule_post",
      "get_analytics"
    ]
  },

  "openai_integration": {
    "schema_version": "v1",
    "name_for_human": "Buffer — Cap Fund Academy Social Posts",
    "name_for_model": "buffer_social_automation",
    "description_for_human": "Schedule and publish social media posts to LinkedIn, Instagram, and TikTok via Buffer for Cap Fund Academy's content automation pipeline.",
    "description_for_model": "Use this tool to create, schedule, and manage social media posts for Cap Fund Academy across LinkedIn, Instagram, and TikTok channels via Buffer. You can add posts to the queue, schedule them at specific times, and retrieve channel information. All posts must comply with Cap Fund Academy brand voice: professional, regulatory-specific, never affiliated with USDA.",
    "auth": {
      "type": "oauth",
      "client_url": "https://app.buffer.com/oauth2/authorize",
      "authorization_url": "https://api.bufferapp.com/1/oauth2/token.json",
      "scope": "publish read_access",
      "token_exchange_method": "default_post",
      "verification_tokens": {
        "openai": "REPLACE_WITH_OPENAI_VERIFICATION_TOKEN"
      }
    },
    "api": {
      "type": "mcp",
      "url": "https://mcp.buffer.com/mcp"
    },
    "logo_url": "https://capfundacademy.com/assets/logo-cfa.png",
    "contact_email": "support@capfundacademy.com",
    "legal_info_url": "https://capfundacademy.com/terms"
  },

  "channels": {
    "linkedin": {
      "buffer_profile_id": "6a0bf991090476fb99360fd1",
      "content_type": "text_post",
      "max_chars": 3000,
      "scheduling": "automatic"
    },
    "instagram": {
      "buffer_profile_id": "6a0bf854090476fb99360cd8",
      "content_type": "image_post",
      "max_chars": 2200,
      "scheduling": "automatic"
    },
    "tiktok": {
      "buffer_profile_id": "6a0bf90e090476fb99360eb3",
      "content_type": "video_script_draft",
      "max_chars": 350,
      "scheduling": "save_as_draft"
    }
  },

  "content_policy": {
    "brand": "Cap Fund Academy",
    "compliance_notes": [
      "Never claim USDA affiliation, endorsement, or certification",
      "Never guarantee funding outcomes",
      "Cite CFR sections accurately (e.g. 7 CFR 4280.316)",
      "Target audience: rural nonprofits, CDFIs, tribal organizations",
      "Tone: authoritative, practitioner-focused, regulatory-specific"
    ],
    "forbidden_phrases": [
      "USDA-certified",
      "USDA-approved",
      "USDA-endorsed",
      "guaranteed funding",
      "ensure you get funded"
    ]
  },

  "automation": {
    "schedule": "daily",
    "cron": "0 8 * * *",
    "timezone": "UTC",
    "posts_per_day": 3,
    "platforms_per_day": ["linkedin", "instagram", "tiktok"],
    "includes_blog": true,
    "image_generation": "dall-e-3",
    "text_generation": "gpt-4o"
  },

  "environment": {
    "netlify_function": "daily-content-background",
    "function_url": "https://capfundacademy.com/.netlify/functions/daily-content-background",
    "buffer_access_token_env": "BUFFER_ACCESS_TOKEN",
    "buffer_profile_linkedin_env": "BUFFER_PROFILE_LINKEDIN",
    "buffer_profile_instagram_env": "BUFFER_PROFILE_INSTAGRAM",
    "buffer_profile_tiktok_env": "BUFFER_PROFILE_TIKTOK",
    "openai_api_key_env": "OPENAI_API_KEY"
  }
}
